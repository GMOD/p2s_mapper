// Source for docs/img/pipeline.svg, which docs/pipeline.md and the README embed.
// Regenerate with: dot -Tsvg docs/img/pipeline.dot -o docs/img/pipeline.svg
//
// Deliberately the MAIN PATH only. The quality check, the SIFTS trim and the
// choice of structure source are in docs/pipeline.md instead: a diagram that
// shows every branch stops being the thing you look at first.
//
// SYNC: palette follows ~/src/gmod/bam-js/docs/img/dataflow.dot.
digraph p2smapper {
  rankdir=TB
  bgcolor="white"
  nodesep=0.5
  ranksep=0.45
  node [shape=box style="filled,rounded" fillcolor="#f6f8fa" color="#57606a"
        fontname="Helvetica" fontsize=11 margin="0.18,0.09"]
  edge [color="#57606a" fontname="Helvetica" fontsize=10]

  gene      [label="a gene\nexons and strand" fillcolor="#ddf4ff" color="#0969da"]
  protein   [label="its protein sequence\nand genome ↔ protein positions\n(g2p_mapper)" fillcolor="#fbefff" color="#8250df"]
  structure [label="3D structures of that protein\nAlphaFold or PDB" fillcolor="#dafbe1" color="#1a7f37"]
  chain     [label="pick the chain that is this protein\nchooseMappedEntity" fillcolor="#ffd8b5" color="#bc4c00"]
  lookup    [label="residue lookup\nmakeCoordinateMapper" fillcolor="#ffd8b5" color="#bc4c00"]
  result    [label="click a residue in 3D → its codon on the genome\nclick the genome → its residue in 3D" fillcolor="#ddf4ff" color="#0969da"]

  gene -> protein
  gene -> structure [label=" via UniProt "]
  protein -> chain
  structure -> chain
  chain -> lookup [label=" alignment "]
  lookup -> result
  protein -> result [label=" genome positions "]
}
