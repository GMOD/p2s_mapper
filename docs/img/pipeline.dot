digraph pipeline {
  rankdir = TB
  bgcolor = "white"
  nodesep = 0.4
  ranksep = 0.45

  node [
    fontname = "Helvetica,Arial,sans-serif"
    fontsize = 12
    fontcolor = "#1f2328"
    color = "#8c959f"
    style = "filled"
    fillcolor = "#f6f8fa"
    shape = box
    margin = "0.2,0.12"
  ]
  edge [
    fontname = "Helvetica,Arial,sans-serif"
    fontsize = 10
    fontcolor = "#57606a"
    color = "#8c959f"
    arrowsize = 0.7
  ]

  gene [label = "A gene on the genome", fillcolor = "#ddf4ff"]
  protein [label = "Its protein, spelled out\nas a string of amino acids"]
  find [label = "Look up 3D structures\nof that protein"]
  chain [label = "Pick the chain in the structure\nthat is this protein"]
  match [label = "Line the two sequences up\nresidue by residue"]
  official [label = "Cross-check against the\nofficial residue numbering\n(optional)"]
  maps [label = "Result: a lookup table\nfrom any position to its partner", fillcolor = "#dafbe1"]
  use [label = "Click a residue in 3D,\nsee the DNA; click the DNA,\nsee the residue", fillcolor = "#dafbe1"]

  gene -> protein [label = "g2p_mapper\ngenome ↔ protein"]
  gene -> find
  protein -> match
  find -> chain
  chain -> match
  match -> maps
  chain -> official [style = dashed]
  official -> maps [style = dashed]
  maps -> use
}
