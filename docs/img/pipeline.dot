digraph pipeline {
  rankdir = TB
  bgcolor = "white"
  nodesep = 0.4
  ranksep = 0.45

  node [
    fontname = "Helvetica,Arial,sans-serif"
    fontsize = 11
    fontcolor = "#1f2328"
    color = "#8c959f"
    style = "filled"
    fillcolor = "#f6f8fa"
    shape = box
    margin = "0.18,0.10"
  ]
  edge [
    fontname = "Helvetica,Arial,sans-serif"
    fontsize = 9
    fontcolor = "#57606a"
    color = "#8c959f"
    arrowsize = 0.7
  ]

  gene [label = "gene / transcript", fillcolor = "#ddf4ff"]
  isoforms [label = "rank isoforms\nclassifyIsoforms · selectBestTranscript"]
  find [label = "find a structure\nfetchAlphaFoldModels · fetchExperimentalStructures\npdbeBestStructures · searchUniProtEntries"]
  load [label = "load the file in Mol*\n(host app; format sniffed from content)", fillcolor = "#fff8c5"]
  entities [label = "read polymer entities\nextractEntities"]
  choose [label = "choose the transcript's entity\nchooseMappedEntity\nidentical residues / shorter sequence"]
  align [label = "align transcript to entity\nrunLocalAlignment (BLOSUM62, affine gaps)"]
  sifts [label = "SIFTS numbering (optional)\nfetchUniProtStructureMappings\nmakeUniProtPositionMap"]
  mapper [label = "build coordinate maps\nmakeCoordinateMapper", fillcolor = "#dafbe1"]
  use [label = "highlight, hover, navigate", fillcolor = "#dafbe1"]

  gene -> isoforms
  gene -> find
  find -> load
  load -> entities
  isoforms -> choose [label = "transcript protein"]
  entities -> choose [label = "candidates"]
  choose -> align [label = "winner"]
  align -> mapper
  entities -> sifts [style = dashed]
  sifts -> mapper [style = dashed, label = "authoritative\nUniProt positions"]
  mapper -> use
}
